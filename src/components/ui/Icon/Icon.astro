---
import './Icon.scss';

const icons = import.meta.glob<string>('/src/assets/icons/*.svg', {
	query: '?raw',
	import: 'default',
	eager: true,
});

interface Props {
	name: string;
	class?: string;
	width?: number | string;
	height?: number | string;
}

const { name, class: className = '', width = 24, height = 24 } = Astro.props;
const svg = icons[`/src/assets/icons/${name}.svg`] ?? icons['/src/assets/icons/default.svg'];
---

<span
	class:list={['icon', className]}
	style={{ '--icon-w': `${Number(width) / 16}rem`, '--icon-h': `${Number(height) / 16}rem` }}
	aria-hidden='true'
	set:html={svg}
/>
