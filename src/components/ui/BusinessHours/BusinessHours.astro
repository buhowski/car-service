---
import './BusinessHours.scss';
import { site } from '../../../data/site';
import { ui } from '../../../config/ui';
import schedule from '../../../content/opening-hours.json';

interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
const { mon, sat } = schedule;
const time = ({ open, close }: { open: string; close: string }) =>
	open && close ? `${open}–${close}` : ui.schedule.closedLabel;
---

<div class:list={['business-hours', className]}>
	<span class='business-hours__city'>{site.city}</span>
	<svg
		xmlns='http://www.w3.org/2000/svg'
		width='1em'
		height='1em'
		viewBox='0 0 24 24'
		fill='none'
		stroke='currentColor'
		stroke-width='2'
		stroke-linecap='round'
		stroke-linejoin='round'
		class='business-hours__clock lucide lucide-clock3'
		aria-hidden='true'
	>
		<circle cx='12' cy='12' r='10'></circle>
		<polyline points='12 6 12 12 16.5 12'></polyline>
	</svg>
	<span class='business-hours__schedule'>
		<span>{ui.schedule.weekdaysLabel}: {time(mon)}</span>
		<span class='business-hours__schedule-dot' aria-hidden='true'> · </span>
		<span>{ui.schedule.saturdayLabel}: {time(sat)}</span>
	</span>
</div>
