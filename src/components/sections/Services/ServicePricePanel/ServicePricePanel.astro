---
import './ServicePricePanel.scss';
import Button from '../../../ui/Button/Button.astro';
import servicesData from '../../../../content/services.json';
import { formatText } from '../../../../data/site';
import { ui } from '../../../../data/ui';

type Service = (typeof servicesData.categories)[number]['services'][number];

interface Props {
	id: string;
	triggerId: string;
	title: string;
	services: Service[];
	active?: boolean;
}

const { id, triggerId, title, services, active = false } = Astro.props;
---

<div class='service-price-panel' id={id} role='region' aria-labelledby={triggerId} hidden={!active}>
	<div class='service-price-panel__heading'>
		<div>
			<span class='service-price-panel__kicker'>{ui.services.panelKicker}</span>
			<h3>{title}</h3>
		</div>
	</div>
	<div class='service-price-panel__list'>
		{
			services.map((service) => (
				<div class='service-price-panel__row'>
					<span class='service-price-panel__name'>{service.name}</span>
					<span class='service-price-panel__price'>
						{service.from ? `${ui.services.priceFromLabel} ` : ''}
						{service.price.toLocaleString('uk-UA')} {ui.services.currencyLabel}
					</span>
					<Button
						variant='primary'
						class='service-price-panel__order'
						aria-label={formatText(ui.services.orderAriaLabel, { service: service.name })}
						data-booking-open
					>
						{ui.services.orderLabel}
					</Button>
				</div>
			))
		}
	</div>
	<p class='service-price-panel__note'>
		{servicesData.priceNote}
	</p>
</div>
