---
import './404.scss';
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button/Button.astro';
import Container from '../components/ui/Container/Container.astro';
---

<Layout noIndex title='Сторінку не знайдено | СТО Поршень'>
	<section class='not-found' aria-labelledby='not-found-title'>
		<Container>
			<p class='not-found__code'>404</p>
			<h1 id='not-found-title' class='not-found__title'>Сторінку не знайдено</h1>
			<p class='not-found__text'>Можливо, посилання застаріло або сторінку перемістили.</p>
			<Button variant='primary-dark' href='/'>На головну</Button>
		</Container>
	</section>
</Layout>
