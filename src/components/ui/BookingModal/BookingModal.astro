---
import './BookingModal.scss';
import Button from '../Button/Button.astro';
import Icon from '../Icon/Icon.astro';
import SocialLinks from '../SocialLinks/SocialLinks.astro';
import { siteSettings } from '../../../data/site';
import { ui } from '../../../data/ui';

const settings = siteSettings;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
// DeV TEST
// const turnstileSiteKey = import.meta.env.DEV
// 	? '1x00000000000000000000AA'
// 	: import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<dialog
	class='booking-modal'
	data-booking-modal
	aria-labelledby='booking-title'
	aria-describedby='booking-description'
>
	<div>
		<div class='booking-modal__panel' data-booking-panel>
			<button
				class='booking-modal__close'
				type='button'
				aria-label={ui.booking.closeLabel}
				data-booking-close
			>
				<Icon name='close' width='16' height='16' />
			</button>

			<h2 class='booking-modal__title' id='booking-title'>
				{settings.booking.title}
			</h2>

			<p class='booking-modal__intro' id='booking-description'>
				{settings.booking.intro}
			</p>

			<form class='booking-form' action='/api/booking' method='post' data-booking-form>
				<div class='booking-form__field'>
					<label for='booking-name'>
						{ui.booking.nameLabel}
						<span class='booking-form__required' aria-hidden='true'> *</span>
					</label>

					<input
						id='booking-name'
						data-booking-name
						name='name'
						type='text'
						autocomplete='name'
						class='form-control'
						minlength='2'
						maxlength='80'
						placeholder={ui.booking.namePlaceholder}
						required
					/>
				</div>

				<div class='booking-form__field'>
					<label for='booking-phone'>
						{ui.booking.phoneLabel}
						<span class='booking-form__required' aria-hidden='true'> *</span>
					</label>

					<div class='booking-form__phone'>
						<span class='booking-form__country-code' aria-hidden='true'>+380</span>

						<input
							id='booking-phone'
							data-booking-phone
							name='phone'
							type='tel'
							inputmode='numeric'
							autocomplete='tel-national'
							placeholder={ui.booking.phonePlaceholder}
							class='form-control'
							pattern='[0-9]{2} [0-9]{3} [0-9]{2} [0-9]{2}'
							title='XX XXX XX XX'
							required
						/>
					</div>
				</div>

				<div class='booking-form__field'>
					<label for='booking-note'>
						{ui.booking.noteLabel}{' '}
						<span class='booking-form__optional'>({ui.booking.optionalLabel})</span>
					</label>

					<textarea
						id='booking-note'
						name='note'
						rows='3'
						class='form-control'
						maxlength='500'
						placeholder={ui.booking.notePlaceholder}></textarea>
				</div>

				<fieldset class='booking-form__contact-method'>
					<legend>{ui.booking.contactMethodLegend}</legend>

					<div class='booking-form__contact-options'>
						{
							ui.booking.contactMethods.map((method, index) => (
								<label>
									<input
										type='radio'
										name='contactMethod'
										value={method}
										checked={index === 0}
										required={index === 0}
									/>
									{method}
								</label>
							))
						}
					</div>
				</fieldset>

				<div class='booking-form__check'>
					<div class='booking-form__hp' aria-hidden='true'>
						<input type='text' name='website' tabindex='-1' autocomplete='off' />
					</div>

					<div
						class='cf-turnstile'
						data-sitekey={turnstileSiteKey}
						data-appearance='interaction-only'
					>
					</div>
				</div>

				<!-- <p class='booking-form__consent'>{ui.booking.consent}</p> -->

				<Button variant='primary-dark' block type='submit' data-booking-submit>
					<span data-submit-label>{ui.booking.submitLabel}</span>
				</Button>

				<div
					class='booking-form__status'
					data-booking-status
					data-state='idle'
					role='status'
					aria-live='polite'
				>
					<p data-booking-status-text></p>
				</div>
			</form>

			<div class='booking-form__alternative'>
				<p class='booking-form__call'>
					{ui.booking.alternativeContact}
				</p>

				<SocialLinks className='booking-form__social' />
			</div>
		</div>
	</div>
</dialog>

<script is:inline src='https://challenges.cloudflare.com/turnstile/v0/api.js' async defer></script>
<script src='../../../scripts/booking-modal.ts'></script>
