---
import './Footer.scss';
import Container from '../ui/Container/Container.astro';
import Icon from '../ui/Icon/Icon.astro';
import BusinessHours from '../ui/BusinessHours/BusinessHours.astro';
import Brand from '../ui/Brand/Brand.astro';
import SocialLinks from '../ui/SocialLinks/SocialLinks.astro';
import { formatText, footerAbout, site } from '../../data/site';
import { ui } from '../../data/ui';

const year = new Date().getFullYear();
---

<footer class='footer' role='contentinfo'>
	<div class='footer__hazard' role='presentation'></div>
	<Container>
		<div class='footer__main'>
			<div>
				<Brand class='footer__brand-link' />
				<p class='footer__about'>{footerAbout}</p>
			</div>

			<address class='footer__contact' aria-label={ui.common.footerContactLabel}>
				<BusinessHours />

				<SocialLinks className='footer__social' />
			</address>
		</div>

		<div class='footer__bottom'>
			<p class='footer__copyright'>
				{formatText(ui.common.copyright, { year, name: site.name })}
			</p>

			<a
				class='footer__contact-item'
				href={site.address.mapUrl}
				target='_blank'
				rel='noopener noreferrer'
			>
				<Icon name='location' width='20' height='20' />
				<span>{site.address.full}</span>
			</a>
		</div>
	</Container>
</footer>
