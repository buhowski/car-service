---
import './BackgroundMedia.scss';

interface Props {
	media: {
		image?: string;
		video?: string;
		mobileVideo?: string;
		alt?: string;
	};
	loading?: 'eager' | 'lazy';
	fetchPriority?: 'high' | 'low' | 'auto';
}

const { media, loading = 'eager', fetchPriority = 'auto' } = Astro.props;

const isLazy = loading === 'lazy';

const desktopVideo = media.video?.trim();
const mobileVideo = media.mobileVideo?.trim();
const imageSource = media.image?.trim();

const videoSource = desktopVideo || mobileVideo;

const hasMobileVideo = Boolean(desktopVideo && mobileVideo && desktopVideo !== mobileVideo);

const getVideoType = (src?: string): string | undefined => {
	const path = src?.split(/[?#]/, 1)[0].toLowerCase();

	if (path?.endsWith('.mp4')) return 'video/mp4';
	if (path?.endsWith('.webm')) return 'video/webm';

	return undefined;
};
---

{
	videoSource ? (
		<video
			class='background-media'
			autoplay
			muted
			loop
			playsinline
			aria-hidden='true'
			width='1920'
			height='1080'
			preload={isLazy ? 'none' : undefined}
			poster={!isLazy ? imageSource || undefined : undefined}
			data-lazy-media={isLazy ? 'video' : undefined}
			data-poster={isLazy ? imageSource || undefined : undefined}
		>
			{hasMobileVideo && (
				<source
					src={!isLazy ? mobileVideo : undefined}
					data-src={isLazy ? mobileVideo : undefined}
					type={getVideoType(mobileVideo)}
					media='(max-width: 767px)'
				/>
			)}

			<source
				src={!isLazy ? videoSource : undefined}
				data-src={isLazy ? videoSource : undefined}
				type={getVideoType(videoSource)}
			/>
		</video>
	) : imageSource ? (
		<img
			class='background-media'
			src={!isLazy ? imageSource : undefined}
			data-src={isLazy ? imageSource : undefined}
			data-lazy-media={isLazy ? 'image' : undefined}
			alt={media.alt}
			width='1920'
			height='1080'
			fetchpriority={isLazy ? 'low' : fetchPriority}
			loading={isLazy ? undefined : 'eager'}
			decoding='async'
		/>
	) : null
}
