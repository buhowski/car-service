---
import './Hours.scss';
import Container from '../../ui/Container/Container.astro';
import SectionHeader from '../../ui/SectionHeader/SectionHeader.astro';
import Icon from '../../ui/Icon/Icon.astro';
import Button from '../../ui/Button/Button.astro';
import { formatText, site } from '../../../data/site';
import { getOpeningHours } from '../../../data/hours';
import { ui } from '../../../config/ui';
import content from '../../../content/hours.json';

const hours = getOpeningHours();
const contacts = [
	{
		icon: 'location',
		label: ui.contacts.addressLabel,
		text: site.address.full,
		href: site.address.mapsUrl,
	},
	{
		icon: 'phone',
		label: ui.contacts.contactLabel,
		text: site.phone.display,
		href: site.phone.href,
	},
];
---

<section class='hours' id='visit' aria-labelledby='visit-heading'>
	<Container>
		<div class='hours__grid'>
			<div class='hours__info reveal'>
				<SectionHeader id='visit-heading' eyebrow={content.eyebrow} headline={content.headline} />
				<p class='lead hours__lead'>{formatText(content.lead)}</p>

				<div class='hours__contact'>
					<div class='hours__line'>
						<Icon name='clock' width='20' height='20' />
						<span>{ui.contacts.scheduleTitle}</span>
					</div>

					<div class='hours__details'>
						<ul
							class='hours__table'
							data-hours-table
							role='list'
							aria-label={ui.contacts.scheduleAriaLabel}
						>
							{
								hours.map((h) => (
									<li
										class:list={['hours__row', h.isClosed && 'hours__row--closed']}
										data-day={h.weekday}
									>
										<span class='hours__day'>{h.day}</span>
										<span class='hours__time'>{h.time}</span>
									</li>
								))
							}
						</ul>
					</div>

					{
						contacts.map((c) => (
							<div class='hours__line'>
								<Icon name={c.icon} width='20' height='20' />
								<div>
									<span>{c.label}</span>
									<div class='hours__links'>
										<a
											class='hours__link'
											href={c.href}
											target={c.href.startsWith('http') ? '_blank' : undefined}
											rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}
										>
											{c.text}
										</a>
									</div>
								</div>
							</div>
						))
					}
				</div>
			</div>

			<div class='hours__map reveal'>
				<iframe
					class='hours__map-canvas'
					src={site.address.mapEmbedUrl}
					loading='lazy'
					title={formatText(ui.contacts.mapTitle)}></iframe>
				<Button
					variant='primary'
					class='hours__map-route'
					href={site.address.directionsUrl}
					target='_blank'
					rel='noopener noreferrer'
				>
					<Icon name='google-maps' width='20' height='20' />
					{ui.contacts.directionsLabel}
				</Button>
			</div>
		</div>
	</Container>
</section>

<script>
	import { highlightToday } from '../../../data/hours';
	highlightToday();
</script>
