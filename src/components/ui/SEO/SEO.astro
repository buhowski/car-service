---
import seo from '../../../content/seo.json';
import services from '../../../content/services.json';
import { formatText, site, siteSettings } from '../../../data/site';
import { getOpeningHoursSpecifications } from '../../../data/hours';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	imageAlt?: string;
	noIndex?: boolean;
}

const { title, description, image, imageAlt, noIndex = false } = Astro.props;
const baseUrl = seo.siteUrl || Astro.site?.toString() || Astro.url.origin;
const root = new URL('/', baseUrl).href;
const absoluteUrl = (path = '') => (path ? new URL(path, baseUrl).href : '');
const titleText = formatText(title ?? seo.title);
const descriptionText = formatText(description ?? seo.description);
const resolvedSocialImage = absoluteUrl(image || seo.openGraph.image);
const socialImageAlt = formatText(imageAlt || titleText || descriptionText);

// Social preview metadata
const socialTitle = titleText;
const socialDescription = descriptionText;
const twitterCard = seo.twitter.card || 'summary_large_image';
const robots = noIndex || import.meta.env.DEV ? 'noindex, nofollow' : seo.robots;

// Local business structured data
const openingHoursSpecification = getOpeningHoursSpecifications();
const coordinates = siteSettings.mapTarget.match(
	/^\s*(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)\s*$/,
);
const geo = coordinates
	? {
			'@type': 'GeoCoordinates',
			latitude: Number(coordinates[1]),
			longitude: Number(coordinates[2]),
		}
	: undefined;
const sameAs = [
	...new Set(
		[
			siteSettings.instagram && site.socialLinks.instagram.href,
			site.address.mapUrl,
			...seo.schema.sameAs,
		].filter((url): url is string => Boolean(url)),
	),
];
const offerCatalog = {
	'@type': 'OfferCatalog',
	name: services.headline,
	itemListElement: services.categories.map((category) => ({
		'@type': 'OfferCatalog',
		name: category.title,
		itemListElement: category.services.map((service) => ({
			'@type': 'Offer',
			itemOffered: { '@type': 'Service', name: service.name },
			priceSpecification: {
				'@type': 'PriceSpecification',
				priceCurrency: seo.schema.currency,
				...(service.from ? { minPrice: service.price } : { price: service.price }),
			},
		})),
	})),
};
const businessId = `${root}#business`;
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': seo.schema.type,
			'@id': businessId,
			name: site.name,
			description: formatText(seo.schema.description) || descriptionText,
			url: root,
			telephone: siteSettings.phoneNumber,
			image: [resolvedSocialImage],
			logo: absoluteUrl(seo.brandImage),
			priceRange: seo.schema.priceRange,
			currenciesAccepted: seo.schema.currency,
			address: {
				'@type': 'PostalAddress',
				streetAddress: site.address.full.replace(/^м\.\s*[^,]+,\s*/, ''),
				addressLocality: site.city,
				addressCountry: 'UA',
			},
			...(geo ? { geo } : {}),
			hasMap: site.address.mapUrl,
			areaServed: { '@type': 'City', name: site.city },
			openingHoursSpecification,
			sameAs,
			hasOfferCatalog: offerCatalog,
		},
		{
			'@type': 'WebSite',
			'@id': `${root}#website`,
			url: root,
			name: site.name,
			inLanguage: seo.language,
			publisher: { '@id': businessId },
		},
	],
};
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<meta name='description' content={descriptionText} />
<meta name='robots' content={robots} />
<meta name='theme-color' content={seo.themeColor} />

<!-- Site verification -->
<meta name='google-site-verification' content={seo.verification.google} />
<meta name='msvalidate.01' content={seo.verification.bing} />
<link rel='canonical' href={root} />
<link rel='icon' href={seo.favicon} />
<title>{titleText}</title>

<!-- Open Graph preview -->
<meta property='og:locale' content={seo.openGraph.locale} />
<meta property='og:type' content={seo.openGraph.type} />
<meta property='og:site_name' content={site.name} />
<meta property='og:title' content={socialTitle} />
<meta property='og:description' content={socialDescription} />
<meta property='og:url' content={root} />
<meta property='og:image' content={resolvedSocialImage} />
<meta property='og:image:alt' content={socialImageAlt} />

<!-- X card preview -->
<meta name='twitter:card' content={twitterCard} />
<meta name='twitter:title' content={socialTitle} />
<meta name='twitter:description' content={socialDescription} />
<meta name='twitter:image' content={resolvedSocialImage} />
<meta name='twitter:image:alt' content={socialImageAlt} />

<script type='application/ld+json' set:html={structuredDataJson} is:inline />
