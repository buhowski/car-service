---
import './Hero.scss';
import Container from '../../ui/Container/Container.astro';
import Button from '../../ui/Button/Button.astro';
import BusinessHours from '../../ui/BusinessHours/BusinessHours.astro';
import BackgroundMedia from '../../ui/BackgroundMedia/BackgroundMedia.astro';
import { site } from '../../../data/site';
import content from '../../../content/hero.json';
const heroData = content;
const headlineLines = [heroData.headline, heroData.headlineSecond];
const highlightedWord = heroData.highlightedWord;
---

<section class='hero' id='hero' aria-labelledby='hero-heading'>
	<div class='hero__background'>
		<BackgroundMedia media={heroData.background} loading='eager' fetchPriority='high' />
	</div>

	<Container>
		<BusinessHours class='hero__meta' />
		<h1 id='hero-heading' class='hero__title' data-reveal>
			{
				headlineLines.map((line) => {
					const wordIndex = line.indexOf(highlightedWord);

					return (
						<span class='hero__title-line'>
							{wordIndex === -1 ? (
								line
							) : (
								<>
									{line.slice(0, wordIndex)}
									<span class='hero__highlight'>{highlightedWord}</span>
									{line.slice(wordIndex + highlightedWord.length)}
								</>
							)}
						</span>
					);
				})
			}
		</h1>
		<p class='hero__sub' data-reveal>{heroData.subtext}</p>

		<div class='hero__actions' data-reveal>
			<Button variant='primary' data-booking-open>{heroData.primaryCta}</Button>

			<Button variant='secondary' href={site.links.services}>{heroData.secondaryCta}</Button>
		</div>
	</Container>
</section>
