---
import './SocialLinks.scss';
import Icon from '../Icon/Icon.astro';
import { formatText, site } from '../../../data/site';
import { ui } from '../../../data/ui';

interface Props {
	className?: string;
	socialOnly?: boolean;
}

type SocialIcon = 'phone' | 'viber' | 'telegram' | 'instagram';

interface SocialLink {
	href: string;
	label: string;
	title?: string;
	icon: SocialIcon;
}

const { className = '', socialOnly = false } = Astro.props;

const phoneLink: SocialLink = {
	href: site.phone.href,
	label: formatText(ui.common.phoneAccessibleLabel),
	title: ui.common.phoneTitle,
	icon: 'phone',
};

const links: SocialLink[] = [
	...(socialOnly ? [] : [phoneLink]),
	site.socialLinks.telegram,
	site.socialLinks.viber,
	...(site.socialLinks.instagram.href ? [site.socialLinks.instagram] : []),
];

const isExternalUrl = (href: string) => href.startsWith('https://') || href.startsWith('http://');
---

<nav
	class={`social-links ${className}`.trim()}
	aria-label={socialOnly ? ui.common.socialNavLabel : ui.common.contactSocialNavLabel}
>
	{
		links.map((link) => (
			<a
				class='social-links__item'
				href={link.href}
				aria-label={link.label}
				title={link.title}
				target={isExternalUrl(link.href) ? '_blank' : undefined}
				rel={isExternalUrl(link.href) ? 'noopener noreferrer' : undefined}
			>
				<Icon name={link.icon} width='22' height='22' />
			</a>
		))
	}
</nav>
