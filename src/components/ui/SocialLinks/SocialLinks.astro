---
import './SocialLinks.scss';
import Icon from '../Icon/Icon.astro';
import { formatText, site } from '../../../data/site';
import { ui } from '../../../config/ui';

interface Props {
	className?: string;
	socialOnly?: boolean;
}

type SocialIcon = 'phone' | 'viber' | 'telegram' | 'instagram';

const { className = '', socialOnly = false } = Astro.props;
const phoneLink = {
	href: site.phone.href,
	label: formatText(ui.common.phoneAccessibleLabel),
	title: ui.common.phoneTitle,
	icon: 'phone' as const,
};
const links: Array<{ href: string; label: string; title?: string; icon: SocialIcon }> = [
	...(socialOnly ? [] : [phoneLink]),
	site.socialLinks.telegram,
	site.socialLinks.viber,
	...(site.socialLinks.instagram ? [site.socialLinks.instagram] : []),
];
---

<nav
	class={`social-links ${className}`.trim()}
	aria-label={socialOnly ? ui.common.socialNavLabel : ui.common.contactSocialNavLabel}
>
	{
		links.map((link) => (
			<a
				class='social-links__item'
				href={link.href}
				aria-label={link.label}
				target={link.href.startsWith('https://') ? '_blank' : undefined}
				rel={link.href.startsWith('https://') ? 'noopener noreferrer' : undefined}
			>
				<Icon name={link.icon} width='22' height='22' />
			</a>
		))
	}
</nav>
