---
import './Brand.scss';
import { formatText, site } from '../../../data/site';
import { ui } from '../../../data/ui';
import Icon from '../Icon/Icon.astro';

interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
const brandImage = site.brand.image?.trim();
---

<a class:list={['brand', className]} href='#home' aria-label={formatText(ui.common.brandHomeLabel)}>
	<span class='brand__mark' aria-hidden='true'>
		{
			brandImage ? (
				<img src={brandImage} alt='' width='40' height='40' />
			) : (
				<Icon name='brandMark' width='26' height='26' />
			)
		}
	</span>
	{site.brand.prefix}
	<b class='brand__name'>{site.brand.name}</b>
</a>
