---
import './NavLinks.scss';
import { site } from '../../../data/site';

interface Props {
	className?: string;
}

const { className = '' } = Astro.props;
const links = site.navigation;
const navigationBase = Astro.url.pathname === '/' ? '' : '/';
---

<ul class={className} role='list'>
	{
		links.map((link) => (
			<li>
				<a class='nav-links__item' data-nav-link href={`${navigationBase}${link.href}`}>
					{link.label}
				</a>
			</li>
		))
	}
</ul>
