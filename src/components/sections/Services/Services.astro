---
import './Services.scss';
import Container from '../../ui/Container/Container.astro';
import SectionHeader from '../../ui/SectionHeader/SectionHeader.astro';
import ServicePricePanel from './ServicePricePanel/ServicePricePanel.astro';
import ServiceCategoryTrigger from './ServiceCategoryTrigger/ServiceCategoryTrigger.astro';
import servicesData from '../../../content/services.json';
const { categories } = servicesData;
---

<section class='services' id='services' aria-labelledby='services-heading'>
	<Container>
		<SectionHeader
			id='services-heading'
			eyebrow={servicesData.eyebrow}
			headline={servicesData.headline}
		/>

		<div class='services__catalog'>
			<div class='services__category-list' data-service-set='desktop'>
				{
					categories.map((category, index) => (
						<ServiceCategoryTrigger
							category={category}
							triggerId={`service-trigger-${index}`}
							panelId={`service-panel-${index}`}
							active={index === 0}
						/>
					))
				}
			</div>

			<div class='services__panel-list' data-service-set='desktop'>
				{
					categories.map((category, index) => (
						<ServicePricePanel
							id={`service-panel-${index}`}
							triggerId={`service-trigger-${index}`}
							title={category.title}
							services={category.services}
							active={index === 0}
						/>
					))
				}
			</div>
		</div>

		<div class='services__mobile-list' data-service-set='mobile'>
			{
				categories.map((category, index) => (
					<div class='services__entry'>
						<ServiceCategoryTrigger
							category={category}
							triggerId={`mobile-service-trigger-${index}`}
							panelId={`mobile-service-panel-${index}`}
							active={index === 0}
						/>
						<ServicePricePanel
							id={`mobile-service-panel-${index}`}
							triggerId={`mobile-service-trigger-${index}`}
							title={category.title}
							services={category.services}
							active={index === 0}
						/>
					</div>
				))
			}
		</div>
	</Container>
</section>

<script src='../../../scripts/services.ts'></script>
